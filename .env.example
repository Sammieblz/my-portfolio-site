# Optional: improves weather in the status bar via OpenWeatherMap.
# Without it, /api/weather falls back to Open-Meteo (no key).
OPENWEATHER_API_KEY=

# Server-side Formspree project endpoint. The included value is a public form identifier,
# but keeping delivery configuration server-side allows same-origin validation and limits.
FORMSPREE_ENDPOINT=https://formspree.io/f/mqkvbjro

# Optional server-side GitHub token for higher API limits. Never prefix with PUBLIC_.
GITHUB_TOKEN=
