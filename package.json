{
	"name": "my-portfolio-site",
	"version": "1.0.0",
	"private": true,
	"description": "Samuel Ndubuisi's accessible, OS-inspired developer portfolio.",
	"engines": {
		"node": "24.x",
		"npm": ">=11"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"assets:generate": "node scripts/generate-static-images.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json --watch",
		"lint": "npm run lint:format && npm run lint:eslint",
		"lint:format": "prettier --check .",
		"lint:eslint": "eslint . --max-warnings=0",
		"format": "prettier --write .",
		"test": "npm run test:unit",
		"test:unit": "vitest run",
		"test:unit:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"verify": "npm run check && npm run lint && npm run test:coverage && npm run build && npm run budget",
		"budget": "node scripts/check-bundle-budget.mjs",
		"links:check": "node scripts/check-links.mjs",
		"audit": "npm audit --omit=dev --audit-level=high"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.2.9",
		"@vitest/coverage-v8": "^4.1.11",
		"autoprefixer": "^10.4.23",
		"eslint": "^10.9.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"jsdom": "^30.0.1",
		"postcss": "^8.5.26",
		"prettier": "^3.9.0",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^4.1.0"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"sucrase": {
			"glob": "^11.1.0"
		}
	},
	"type": "module",
	"dependencies": {
		"@fortawesome/fontawesome-free": "^7.3.1"
	}
}
